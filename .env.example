# chanlun-pro 环境变量模板
#
# 用法：
#   cp .env.example .env
#   按需填写真实值；.env 已被 .gitignore 排除，绝不要提交到仓库。
#
# 加载方式（任选其一）：
#   - systemd:   EnvironmentFile=/path/to/.env
#   - docker:    docker run --env-file .env ...
#   - 命令行:    set -a; source .env; set +a; python -m chanlun_chart
#   - python:    pip install python-dotenv，然后在入口最早处 from dotenv import load_dotenv; load_dotenv()
#
# 命名约定：所有键以 CHANLUN_ 开头，便于与系统其他变量隔离。

# ---------- WEB 服务 ----------
CHANLUN_WEB_HOST=127.0.0.1
# 推荐使用 werkzeug 哈希（pbkdf2: 开头）；明文仅限本机调试。
# 生成: python -c "from werkzeug.security import generate_password_hash;print(generate_password_hash('your_pwd'))"
CHANLUN_LOGIN_PWD=
# 留空则按 env > 持久化文件 解析；建议: python -c "import secrets;print(secrets.token_hex(32))"
CHANLUN_FLASK_SECRET_KEY=
CHANLUN_DATA_PATH=.chanlun_pro
CHANLUN_PROXY_HOST=127.0.0.1
CHANLUN_PROXY_PORT=7890

# ---------- 数据库 ----------
CHANLUN_DB_TYPE=sqlite
CHANLUN_DB_HOST=127.0.0.1
CHANLUN_DB_PORT=3306
CHANLUN_DB_USER=root
CHANLUN_DB_PWD=
CHANLUN_DB_DATABASE=chanlun_klines

# ---------- Redis ----------
CHANLUN_REDIS_HOST=
CHANLUN_REDIS_PORT=6379

# ---------- 行情数据源（详见 config.py.demo 注释） ----------
CHANLUN_EXCHANGE_A=tdx
CHANLUN_EXCHANGE_HK=tdx_hk
CHANLUN_EXCHANGE_FUTURES=tdx_futures
CHANLUN_EXCHANGE_NY_FUTURES=tdx_ny_futures
CHANLUN_EXCHANGE_CURRENCY=binance
CHANLUN_EXCHANGE_CURRENCY_SPOT=binance_spot
CHANLUN_EXCHANGE_US=tdx_us
CHANLUN_EXCHANGE_FX=tdx_fx
CHANLUN_TDX_PATH=

# ---------- 第三方账号 ----------
# 掘金量化
CHANLUN_GM_SERVER_ADDR=127.0.0.1:7001
CHANLUN_GM_TOKEN=

# 富途
CHANLUN_FUTU_HOST=
CHANLUN_FUTU_PORT=11111
CHANLUN_FUTU_UNLOCK_PWD=

# 天勤
CHANLUN_TQ_USER=
CHANLUN_TQ_PWD=
CHANLUN_TQ_SP_NAME=simnow
CHANLUN_TQ_SP_ACCOUNT=
CHANLUN_TQ_SP_PWD=

# CTP 期货
CHANLUN_CTP_BROKER_ID=
CHANLUN_CTP_USER_ID=
CHANLUN_CTP_PASSWORD=
CHANLUN_CTP_APP_ID=client_chanlun-pro_1.0
CHANLUN_CTP_AUTH_CODE=
CHANLUN_CTP_MD_FRONT=
CHANLUN_CTP_TD_FRONT=

# 数字货币
CHANLUN_BINANCE_APIKEY=
CHANLUN_BINANCE_SECRET=
CHANLUN_ZB_APIKEY=
CHANLUN_ZB_SECRET=

# 美股
CHANLUN_POLYGON_APIKEY=
CHANLUN_ALPACA_APIKEY=
CHANLUN_ALPACA_SECRET=
CHANLUN_IB_HOST=127.0.0.1
CHANLUN_IB_PORT=7497
CHANLUN_IB_CLIENT_ID=1
CHANLUN_IB_ACCOUNT=

# AI（硅基流动 / OpenRouter，二选一）
CHANLUN_AI_TOKEN=
CHANLUN_AI_MODEL=Pro/deepseek-ai/DeepSeek-R1
CHANLUN_OPENROUTER_AI_KEYS=
CHANLUN_OPENROUTER_AI_MODEL=google/gemini-2.5-pro-preview

# 飞书：把整个 dict 序列化为 JSON 一次性传入
# 示例: '{"default":{"app_id":"cli_xxx","app_secret":"xxx"},"a":{"app_id":"...","app_secret":"..."},"user_id":"86xxxxxxxx","enable_img":false}'
CHANLUN_FEISHU_KEYS_JSON=
CHANLUN_FEISHU_USER_ID=

# ---------- 启动行为 ----------
# 逗号分隔；可选: a,hk,us,fx,futures,ny_futures,currency,currency_spot
CHANLUN_PRELOAD_MARKETS=a,hk,us
CHANLUN_PRELOAD_STARTUP_DELAY_SECONDS=60
