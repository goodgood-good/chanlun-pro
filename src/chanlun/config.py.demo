import os
import pathlib

"""
服务总配置文件
"""


def _load_dotenv(env_path=None) -> None:
    """极简 .env 加载器：从项目根 .env 读 KEY=VALUE 注入到 os.environ。

    - 不覆盖进程已存在的真实 env（优先级：真实 env > .env 文件 > 代码默认 ''）。
    - 免依赖（不引 python-dotenv），仅支持 KEY=VALUE / # 注释 / 空行。
    - 解决 IDE（PyCharm 等）启动早于 setx 时读不到环境变量的问题。
    - .env 已在 .gitignore 中，不会被纳入 git。
    """
    try:
        # config.py 位于 src/chanlun/，项目根是 parents[2]
        env_file = (
            env_path if env_path is not None
            else pathlib.Path(__file__).resolve().parents[2] / '.env'
        )
        if not env_file.is_file():
            return
        try:
            # utf-8-sig 自动剥 BOM(C4: 带 BOM 时首行 KEY 被污染成 ﻿KEY 致该项静默失效)
            content = env_file.read_text(encoding='utf-8-sig')
        except UnicodeDecodeError:
            # C3: .env 含非 UTF-8 字节(Windows 记事本 ANSI/GBK 存中文)不得升级为应用启动崩溃
            content = env_file.read_text(encoding='gbk', errors='replace')
        for line in content.splitlines():
            line = line.strip()
            if not line or line.startswith('#') or '=' not in line:
                continue
            k, v = line.split('=', 1)
            k = k.strip()
            v = v.strip().strip('"').strip("'")
            if k:
                os.environ.setdefault(k, v)
    except OSError:
        pass


_load_dotenv()

# WEB服务访问IP地址，本机部署设置为 127.0.0.1；局域网或外网部署，设置为该机器的IP地址，或者设置 0.0.0.0 则可使用机器所有IP地址进行访问。
WEB_HOST = os.environ.get('CHANLUN_WEB_HOST', '127.0.0.1')

# SSE 实时推送：默认开；关闭则前后端退回纯轮询(现状)。
ENABLE_SSE_PUSH = True
# 服务端缠论重算+推送间隔(毫秒)；2026-06-23 从 3000/5000 上调到 8000 降 CPU 负载:
# 每标的每隔此间隔重算, 频率过高时多标的 + 拉取并发争 GIL(实测重算飙到几十秒)。8s 减少
# 同时重算、缓解争用; 代价是缠论更新延迟 3s→8s。
SSE_REFRESH_MS = 8000
SSE_REFRESH_MS_US = 8000

