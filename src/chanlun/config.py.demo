import json
import os
import pathlib

"""
服务总配置文件（模板）

用法：
    cp src/chanlun/config.py.demo src/chanlun/config.py

安全约定：
- 所有秘密（密码 / API Key / Secret / Token）默认从环境变量读取，
  仓库不再保存任何明文凭证。
- 优先级：环境变量 > config.py 中的覆盖值 > 模块默认值。
- 推荐做法：把秘密写到项目根目录的 .env 文件（已被 .gitignore），
  由进程管理器（如 systemd / docker / pm2）或 dotenv 工具加载到 env。
- 详见根目录 .env.example 中的变量清单。
"""


def _env(name: str, default: str = "") -> str:
    """从环境变量读取字符串；未设置或为空则返回 default。"""
    val = os.environ.get(name)
    return val if val not in (None, "") else default


def _env_int(name: str, default: int) -> int:
    val = os.environ.get(name)
    if val in (None, ""):
        return default
    try:
        return int(val)
    except ValueError:
        return default


# ============================================================
# WEB 服务
# ============================================================
# WEB服务访问IP地址：本机部署 127.0.0.1；外网部署填本机 IP 或 0.0.0.0。
