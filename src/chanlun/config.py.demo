# ============================================================
# 飞书消息
# ============================================================
# 推荐：把整个 dict 序列化为 JSON 写到 CHANLUN_FEISHU_KEYS_JSON 环境变量。
# 例：export CHANLUN_FEISHU_KEYS_JSON='{"default":{"app_id":"...","app_secret":"..."},"user_id":"..."}'
# 未设置时使用下方占位模板，所有 secret 仍可在 web 页面"系统设置"中加密入库。
def _load_feishu_keys() -> dict:
    raw = os.environ.get("CHANLUN_FEISHU_KEYS_JSON")
    if raw:
        try:
            return json.loads(raw)
        except json.JSONDecodeError:
            pass
    placeholder = {"app_id": "", "app_secret": ""}
    return {
        "default": placeholder.copy(),
        "a": placeholder.copy(),
        "us": placeholder.copy(),
        "hk": placeholder.copy(),
        "fx": placeholder.copy(),
        "futures": placeholder.copy(),
        "ny_futures": placeholder.copy(),
        "currency_spot": placeholder.copy(),
        "currency": placeholder.copy(),
        "user_id": _env("CHANLUN_FEISHU_USER_ID", ""),
        "enable_img": False,
    }


FEISHU_KEYS = _load_feishu_keys()


# ============================================================
# 启动时预加载 symbols 的市场列表
# 可选值: "a"(沪深A股), "hk"(港股), "us"(美股), "fx"(外汇),
#        "futures"(国内期货), "ny_futures"(纽约期货),
#        "currency"(数字货币合约), "currency_spot"(数字货币现货)
# 默认仅预加载 ["a", "hk", "us"], 避免境外/网络受限的市场拖慢启动
# (如通达信期货 30s 超时、币安 451 限制)。
# ============================================================
_preload_raw = _env("CHANLUN_PRELOAD_MARKETS", "a,hk,us")
PRELOAD_MARKETS = [m.strip() for m in _preload_raw.split(",") if m.strip()]

PRELOAD_STARTUP_DELAY_SECONDS = _env_int("CHANLUN_PRELOAD_STARTUP_DELAY_SECONDS", 60)


def get_data_path():
    # 获取项目数据的目录
    data_path = pathlib.Path(DATA_PATH)
    if DATA_PATH.startswith("."):
        data_path = pathlib.Path().home() / DATA_PATH
    # 加 exist_ok=True：避免多进程并发首启时（如 ProcessPoolExecutor）
    # 两个进程同时进入 if，第二个 mkdir 抛 FileExistsError。
    data_path.mkdir(parents=True, exist_ok=True)
    return data_path
