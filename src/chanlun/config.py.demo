# 启动时预加载 symbols 的市场列表
# 不在列表中的市场首次访问时才会按需加载, 仍可正常使用; 列表越短启动越快。
# 可选值: "a"(沪深A股), "hk"(港股), "us"(美股), "fx"(外汇),
#        "futures"(国内期货), "ny_futures"(纽约期货),
#        "currency"(数字货币合约), "currency_spot"(数字货币现货)
# 不配置该项时默认仅预加载 ["a", "hk", "us"], 避免境外/网络受限的市场拖慢启动 (如通达信期货 30s 超时、币安 451 限制)。
PRELOAD_MARKETS = ["a", "hk", "us"]

def get_data_path():
    # 获取项目数据的目录
    data_path = pathlib.Path(DATA_PATH)
    if DATA_PATH.startswith("."):
        data_path = pathlib.Path().home() / DATA_PATH
    if data_path.is_dir() is False:
        data_path.mkdir(parents=True)
    return data_path


# ===== 长桥（cq）月度配额防御配置 =====
# 长桥按订阅级别限制每月可查询的不同 history kline symbol 数量：
#   基础账户 100 / 10K HKD+ 400 / 800K HKD+ 2000 / 6M HKD+ 3000
# 触发 301607 后到月初前任何"新"symbol 都拿不到 K 线。
# 下面两项用于把烧配额行为收敛到可控范围。

# 月度配额上限（按你的实际订阅级别填）。设为 0 表示不做预检查（仅在 301607 后被动收敛）。
LB_QUOTA_MONTHLY_LIMIT = 100

# 美股历史 K 线数据源：
#   "longbridge" - 走长桥（默认；占用 LB_QUOTA_MONTHLY_LIMIT 配额）
# 只支持 "longbridge"（长桥）与 "usmart"（盈立）。
# 长桥实时报价不受影响，仍走 cq。
US_HISTORY_KLINE_SOURCE = "longbridge"
